		{"id":"8adb2d34ca369a67","x":-3720,"y":320,"width":392,"height":57,"color":"1","type":"text","text":"#### ODSTRANIT ZMÍNKY O TOM, ŽE JE VANIŠ MÍSTOPŘEDSEDA SPOLKU "},
		{"id":"44699639843bb7b3","x":-3217,"y":880,"width":220,"height":50,"color":"2","type":"text","text":"# 85/2024\n"},
		{"id":"1dea3516023253b7","x":-2840,"y":1301,"width":360,"height":50,"type":"text","text":"## DÚKAZNÍ PŘEHLED FUNKCE"},
		{"id":"7464085c59c53b02","x":-2823,"y":1113,"width":327,"height":157,"color":"4","type":"text","text":"# JEJICH ŽALOBA \n- jmenovité seznamy osob od kterých vybírali předsedové oddílů příspěvky"},
